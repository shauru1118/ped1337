# Ped1337 — copy to .env and fill in secrets
HOST=0.0.0.0
PORT=8000
TEMP_DIR_PATH=temp
KEY_FILE_PATH=key.key

# Leave empty / unset to run web UI only.
# Do NOT set to the string "false".
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=

# When token is set and this is unset, the web process starts the bot in a thread.
# Set explicitly to false if you run `python -m bot` / compose profile `bot` separately.
RUN_TELEGRAM_BOT=false

CLEANUP_MAX_AGE_SECONDS=300
CLEANUP_INTERVAL_SECONDS=60
