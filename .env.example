# Ped1337 — copy to .env and fill in secrets

HOST=0.0.0.0
PORT=8000

# Local defaults (relative paths are fine on a writable checkout)
TEMP_DIR_PATH=temp
KEY_FILE_PATH=key.key
GENERATED_STATIC_DIR=temp/generated

# Optional stable default key (Base64 of 32 raw bytes).
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# DEFAULT_KEY_B64=

# Leave empty / unset to run web UI only.
# Do NOT set to the string "false".
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
RUN_TELEGRAM_BOT=false

CLEANUP_MAX_AGE_SECONDS=300
CLEANUP_INTERVAL_SECONDS=60

# --- Railway tip ---
# Do NOT set KEY_FILE_PATH=key.key in Railway Variables.
# Either leave unset (uses /tmp/ped1337/...) or set:
#   WRITABLE_DIR=/tmp/ped1337
#   KEY_FILE_PATH=/tmp/ped1337/key.key
#   TEMP_DIR_PATH=/tmp/ped1337/temp
#   GENERATED_STATIC_DIR=/tmp/ped1337/generated
# Prefer DEFAULT_KEY_B64 so the key survives container restarts.
